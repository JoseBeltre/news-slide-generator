Options -MultiViews
RewriteEngine On
RewriteBase /

# Bots de IA: 403 en todo el sitio (P9). Google, Bing y los robots de vista previa sí entran (robots.txt).
RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|CCBot|Bytespider|Amazonbot|meta-externalagent|Applebot-Extended|cohere-ai|Diffbot|YouBot|DuckAssistBot|MistralAI-User|Google-CloudVertexBot) [NC]
RewriteRule ^ - [F,L]

# Página pública de anuncios (P9): su propia página, fuera de la app.
RewriteRule ^anuncios/publico/?$ /publico.html [L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|publico\.html|sw\.js|publico-sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "max-age=31536000, immutable"
  </If>
  # Fuera de los buscadores, salvo la página pública y su imagen para compartir.
  Header set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} !~ m#^/(anuncios/publico/?|publico\.html|og-publico\.png)$#"
</IfModule>
